{
  "name": "meetspace-backend",
  "version": "1.0.0",
  "description": "Production backend for MeetSpace video meetings",
  "type": "module",
  "engines": { "node": ">=18.0.0" },
  "main": "src/index.js",
  "scripts": {
    "dev":          "nodemon --watch src --ext js src/index.js",
    "start":        "node src/index.js",
    "db:generate":  "prisma generate",
    "db:push":      "prisma db push",
    "db:migrate":   "prisma migrate deploy",
    "db:studio":    "prisma studio",
    "db:seed":      "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client":      "^5.10.0",
    "cookie-parser":       "^1.4.6",
    "cors":                "^2.8.5",
    "dotenv":              "^16.4.5",
    "express":             "^4.18.3",
    "express-rate-limit":  "^7.2.0",
    "google-auth-library": "^9.7.0",
    "helmet":              "^7.1.0",
    "jsonwebtoken":        "^9.0.2",
    "morgan":              "^1.10.0",
    "nanoid":              "^5.0.7",
    "socket.io":           "^4.7.4",
    "winston":             "^3.12.0",
    "zod":                 "^3.22.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "prisma":  "^5.10.0"
  }
}
